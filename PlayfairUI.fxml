<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.text.Text?>

<VBox spacing="15" alignment="CENTER" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.playfaircipher.PlayfairController" style="-fx-background-color: #f4f4f4;">
    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <Text text="Playfair Cipher Tool" style="-fx-font-size: 24px; -fx-font-weight: bold;"/>

    <GridPane hgap="10" vgap="10" alignment="CENTER">
        <Label text="Cipher Key:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <TextField fx:id="keyField" promptText="Enter key..." GridPane.rowIndex="0" GridPane.columnIndex="1"/>

        <Label text="Omit Letter:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <ComboBox fx:id="omitCombo" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

        <Label text="Message:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
        <TextField fx:id="messageField" promptText="Enter message..." GridPane.rowIndex="2" GridPane.columnIndex="1"/>
    </GridPane>

    <HBox spacing="10" alignment="CENTER">
        <Button text="Generate Grid" onAction="#handleGenerateGrid" style="-fx-background-color: #2196F3; -fx-text-fill: white;"/>
        <Button text="Decrypt" onAction="#handleDecrypt" style="-fx-background-color: #4CAF50; -fx-text-fill: white;"/>
    </HBox>

    <Separator/>

    <VBox alignment="CENTER" spacing="5">
        <Label text="Cipher Grid Visual" style="-fx-font-weight: bold;"/>
        <GridPane fx:id="visualGrid" alignment="CENTER" hgap="5" vgap="5"
                  style="-fx-background-color: white; -fx-padding: 10; -fx-border-color: #ccc;"/>
    </VBox>

    <VBox spacing="5" alignment="CENTER">
        <Label text="Result:"/>
        <TextArea fx:id="resultArea" editable="false" prefHeight="60" wrapText="true"/>
    </VBox>
</VBox>
